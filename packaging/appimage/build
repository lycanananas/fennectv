#!/usr/bin/env bash
# Builds FennecTV for Linux (x86-64) as an AppImage in Docker, nothing
# installed on the host:
#
#   packaging/appimage/build
#
# The image (fennectv-appimage) is built first; Docker's cache keeps its
# layers, so after the first run this takes seconds. The source is mounted
# read-only; the build goes to build-appimage/ (incremental, with ccache)
# and the AppImage to dist/, both owned by you.
#
# To throw it all away:
#   docker image rm fennectv-appimage && rm -rf build-appimage
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)

docker build -t fennectv-appimage "$here"
mkdir -p "$repo/build-appimage" "$repo/dist"
docker run --rm \
    --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -v "$repo:/src:ro" \
    -v "$repo/build-appimage:/src/build-appimage" \
    -v "$repo/dist:/src/dist" \
    fennectv-appimage bash /src/packaging/appimage/in-container.sh "$@"
